<Window x:Class="SfDataGridDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:View="clr-namespace:SfDataGridDemo.ViewModel"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SfDataGridDemo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <View:ViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="350"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        
        <syncfusion:SfDataGrid x:Name="dataGrid" ItemsSource="{Binding Orders}" AutoGenerateColumns="False">
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridNumericColumn MappingName="OrderID" HeaderText= "Order ID"/>
                <syncfusion:GridTextColumn MappingName="CustomerName" HeaderText = "Customer Name"/>
                <syncfusion:GridTextColumn MappingName="CustomerID" HeaderText = "Customer ID"/>
                <syncfusion:GridTextColumn MappingName="Country" HeaderText= "Country" />
                <syncfusion:GridTextColumn MappingName="ShipCity" HeaderText = "Ship City"/>
                <syncfusion:GridDateTimeColumn MappingName="OrderDate" HeaderText = "Order Date" />
            </syncfusion:SfDataGrid.Columns>            
        </syncfusion:SfDataGrid>
        
        <Button Content="Export" Grid.Row="1" Height="25" Width="100" Click="OnExcelExporting"/>
    </Grid>
</Window>
